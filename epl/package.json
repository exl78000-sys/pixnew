{
  "name": "epl-warroom",
  "version": "1.0.0",
  "private": true,
  "description": "英超戰情室 — Premier League match / player / tactics / coach analysis platform",
  "type": "module",
  "scripts": {
    "fetch": "node scripts/fetch.mjs",
    "build": "node scripts/build.mjs",
    "all": "node scripts/fetch.mjs --force && node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node scripts/test.mjs && node scripts/test-laliga.mjs",
    "news": "node scripts/fetch-news.mjs",
    "bundle": "node scripts/bundle.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "live": "node scripts/fetch-live.mjs",
    "postmatch": "node scripts/fetch-postmatch.mjs",
    "laliga:postmatch": "node scripts/fetch-postmatch.mjs --league=es1",
    "crests": "node scripts/fetch-crests.mjs",
    "laliga:crests": "node scripts/fetch-crests.mjs --league=es1",
    "photos": "node scripts/fetch-photos.mjs",
    "season": "node scripts/fetch-season.mjs",
    "live:watch": "node scripts/live-server.mjs",
    "coaches:check": "node scripts/fetch-coaches.mjs",
    "probe:apis": "node scripts/probe-apis.mjs",
    "explore:apis": "node scripts/explore-apis.mjs",
    "official": "node scripts/fetch-official.mjs",
    "odds": "node scripts/fetch-odds.mjs",
    "setpieces": "node scripts/fetch-setpieces.mjs",
    "laliga:setpieces": "node scripts/fetch-setpieces.mjs --league=es1",
    "laliga:fetch": "node scripts/fetch-laliga.mjs",
    "laliga:build": "node scripts/build-laliga.mjs",
    "tune:form": "node scripts/tune-form.mjs",
    "snapshot": "node scripts/snapshot-availability.mjs",
    "probe:goals": "node scripts/probe-goals.mjs",
    "probe:events": "node scripts/probe-events.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
