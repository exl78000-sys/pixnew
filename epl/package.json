{
  "name": "epl-warroom",
  "version": "1.0.0",
  "private": true,
  "description": "英超戰情室 — Premier League match / player / tactics / coach analysis platform",
  "type": "module",
  "scripts": {
    "fetch": "node scripts/fetch.mjs",
    "build": "node scripts/build.mjs",
    "all": "node scripts/fetch.mjs --force && node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node scripts/test.mjs && node scripts/backtest-laliga.mjs && node scripts/test-laliga.mjs",
    "news": "node scripts/fetch-news.mjs",
    "bundle": "node scripts/bundle.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "live": "node scripts/fetch-live.mjs",
    "postmatch": "node scripts/fetch-postmatch.mjs",
    "laliga:postmatch": "node scripts/fetch-postmatch.mjs --league=es1",
    "crests": "node scripts/fetch-crests.mjs",
    "laliga:crests": "node scripts/fetch-crests.mjs --league=es1",
    "laliga:history-crests": "node scripts/fetch-crests.mjs --league=es1 --include-history",
    "photos": "node scripts/fetch-photos.mjs",
    "photos:api": "node scripts/fetch-api-photos.mjs",
    "season": "node scripts/fetch-season.mjs",
    "live:watch": "node scripts/live-server.mjs",
    "local:watch": "node scripts/live-server.mjs --laliga",
    "local:sync": "node scripts/local-sync.mjs",
    "laliga:live": "node scripts/fetch-laliga-live.mjs",
    "coaches:check": "node scripts/fetch-coaches.mjs",
    "probe:apis": "node scripts/probe-apis.mjs",
    "explore:apis": "node scripts/explore-apis.mjs",
    "official": "node scripts/fetch-official.mjs",
    "odds": "node scripts/fetch-odds.mjs",
    "laliga:odds": "node scripts/fetch-odds.mjs --league=es1",
    "setpieces": "node scripts/fetch-setpieces.mjs",
    "laliga:setpieces": "node scripts/fetch-setpieces.mjs --league=es1",
    "laliga:fetch": "node scripts/fetch-laliga.mjs",
    "laliga:build": "node scripts/build-laliga.mjs",
    "laliga:backtest": "node scripts/backtest-laliga.mjs",
    "tune:form": "node scripts/tune-form.mjs",
    "snapshot": "node scripts/snapshot-availability.mjs",
    "probe:goals": "node scripts/probe-goals.mjs",
    "probe:events": "node scripts/probe-events.mjs",
    "probe:laliga-players": "node scripts/probe-laliga-players.mjs",
    "probe:laliga-playerdata": "node scripts/probe-laliga-playerdata.mjs",
    "probe:laliga-lineups": "node scripts/probe-laliga-lineups.mjs",
    "probe:sportmonks": "node scripts/probe-sportmonks.mjs",
    "sportmonks:capabilities": "node scripts/probe-sportmonks-capabilities.mjs",
    "laliga:lineups": "node scripts/fetch-laliga-lineups.mjs",
    "laliga:official-lineups": "node scripts/fetch-laliga-official-lineups.mjs",
    "laliga:official-coaches": "node scripts/fetch-laliga-official-coaches.mjs",
    "coach-photos": "node scripts/fetch-coach-photos.mjs",
    "laliga:players": "node scripts/fetch-laliga-players.mjs",
    "sportmonks:sync": "node scripts/fetch-sportmonks.mjs",
    "tune:situations": "node scripts/tune-situations.mjs",
    "tune:congestion": "node scripts/tune-congestion.mjs",
    "news:translate": "node scripts/translate-news.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
